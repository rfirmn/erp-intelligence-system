# ==============================================================================
# ERP Intelligence Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env with production credentials to source control.

# Application Settings
PROJECT_NAME="ERP Intelligence Dashboard API"
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_STR=/api/v1

# Security & Secrets (GANTI DI SERVER INTERNAL / PRODUKSI!)
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURITY_ENABLED=false

# CORS Configuration (JSON array format or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration (Feature Store)
# Jika DATABASE_URL diisi, parameter komponen di bawahnya menjadi opsional.
# Di Docker Compose: host='postgres', port=5432
# Di Local Mac Dev: host='localhost', port=5432
POSTGRES_USER=rio
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_intelligence_fs

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=10

# ERP Source Connection (Zone 1 Ingestion)
# Kosongkan atau set ERP_MOCK_DATA=true untuk mode development / mock generator
ERP_DATABASE_URL=
ERP_MOCK_DATA=true
ALLOW_MOCK_IN_PRODUCTION=false
INGESTION_BATCH_SIZE=5000
SCHEDULER_ENABLED=true
