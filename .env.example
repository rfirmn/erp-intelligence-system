# ==============================================================================
# ERP Intelligence Dashboard — Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi `.env` di root atau backend/ lalu sesuaikan nilai variabelnya.
# SEMUA model, platform, parameter, dan kredensial dapat dikonfigurasi tanpa mengubah kode.
# JANGAN PERNAH commit file `.env` yang berisi secret/kredensial produksi ke Git.

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="ERP Intelligence Dashboard API"
ENVIRONMENT=development    # development | staging | production
DEBUG=true                 # Set false di production
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Security & Authentication (JWT & Dev User)
# ------------------------------------------------------------------------------
# WAJIB diganti di server staging/produksi (minimal 32 karakter acak yang aman)
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SECURITY_ENABLED: Jika false, endpoint memintas token auth untuk kenyamanan development lokal
SECURITY_ENABLED=false

# Konfigurasi Pengguna Default (Development Mock User)
DEV_USER_ID=usr-001
DEV_USER_USERNAME=admin@isp.net
DEV_USER_PASSWORD=SecretPassword123!
DEV_USER_FULL_NAME="System Administrator"
DEV_USER_ROLE=admin

# ------------------------------------------------------------------------------
# 3. CORS Configuration
# ------------------------------------------------------------------------------
# Format: JSON Array string atau comma-separated list origin frontend yang diizinkan
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration (Feature Store)
# ------------------------------------------------------------------------------
# Jika DATABASE_URL terisi langsung, kredensial POSTGRES_* di bawahnya akan diabaikan.
# Contoh URL langsung: postgresql+asyncpg://rio:secret@localhost:5432/erp_intelligence_fs
DATABASE_URL=

# Pengaturan koneksi individual (Digunakan jika DATABASE_URL kosong):
# - Lingkungan Lokal (Mac/Linux): host='localhost', port=5432
# - Lingkungan Docker Compose: host='postgres', port=5432
POSTGRES_USER=rio
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_intelligence_fs

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 5. ERP Source Database & Ingestion (Zone 1)
# ------------------------------------------------------------------------------
# ERP_DATABASE_URL: URL database ERP sumber untuk sinkronisasi live data.
# Jika kosong, sistem merakit URL dari ERP_DB_* di bawah ini.
ERP_DATABASE_URL=

ERP_DB_USER=erp_user
ERP_DB_PASSWORD=erp_secret_123
ERP_DB_HOST=localhost
ERP_DB_PORT=5433
ERP_DB_NAME=isp_erp_db
ERP_DB_POOL_SIZE=3

# ERP_MOCK_DATA:
# - true : Ingestion menggunakan generator mock internal (aman untuk dev lokal/offline)
# - false: Ingestion mengekstrak data dari database ERP (ERP_DATABASE_URL atau ERP_DB_*)
ERP_MOCK_DATA=true
ALLOW_MOCK_IN_PRODUCTION=false
INGESTION_BATCH_SIZE=5000
SCHEDULER_ENABLED=true

# ------------------------------------------------------------------------------
# 6. AI & LLM Engine Configuration (Zone 3 & 4)
# ------------------------------------------------------------------------------
# Pilihan Provider:
# - "gemini"   : Menggunakan Google Gemini API (Default)
# - "openai"   : Menggunakan OpenAI API atau endpoint lokal kompatibel (Ollama/vLLM)
# - "fallback" : Menggunakan Deterministic Rule-Based Python Engine (Offline / Tanpa Kuota / 100% Gratis)
# Catatan: Jika API Key kosong atau koneksi gagal, sistem otomatis fallback ke mode rule-based tanpa crash.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15.0

# Konfigurasi Google Gemini
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Konfigurasi OpenAI / Compatible Local Endpoint
# Bisa diarahkan ke server lokal: http://localhost:11434/v1 (Ollama) atau http://localhost:8000/v1 (vLLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 7. Agent & Safety Configuration (Zone 3)
# ------------------------------------------------------------------------------
# Batasan baris data maksimal yang diizinkan dieksekusi oleh SafeSQLQueryTool agen
AGENT_SQL_MAX_ROWS=100
# Jumlah maksimum pelanggan risiko tinggi yang dianalisis oleh agen
AGENT_HIGH_RISK_LIMIT=25
